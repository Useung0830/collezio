rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /community/{userId}/{postId}/{imageId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function isUnpublished() {
        return !firestore.exists(/databases/(default)/documents/communityPosts/$(postId));
      }
      allow get: if true;
      allow create: if isOwner() && isUnpublished()
        && imageId.matches('[a-zA-Z0-9-]+')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isOwner() && isUnpublished();
    }
    match /products/{userId}/{fileName} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      allow get: if true;

      allow create: if isOwner()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];

      allow delete: if isOwner();
    }
  }
}
