rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCommunityOwner(authorId) {
      return request.auth != null && request.auth.uid == authorId;
    }
    function isCommunityText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum
        && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }
    match /communityPosts/{postId} {
      function isValidPost(data) {
        return data.keys().hasAll(['authorId', 'title', 'content', 'images', 'createdAt', 'updatedAt', 'likeCount', 'viewCount'])
          && data.keys().hasOnly(['authorId', 'title', 'content', 'images', 'createdAt', 'updatedAt', 'likeCount', 'viewCount'])
          && isCommunityText(data.title, 100) && isCommunityText(data.content, 5000)
          // 이미지 업로드 및 Storage 소유권 검증은 사진 연결 단계에서 추가합니다.
          && data.images is list && data.images.size() == 0;
      }
      function isLikeChange() {
        let path = /databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid);
        let before = resource.data.likeCount;
        let after = request.resource.data.likeCount;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && after is int && after >= 0 && after <= 9007199254740991
          && ((!exists(path) && existsAfter(path) && after == before + 1)
            || (exists(path) && !existsAfter(path) && after == before - 1));
      }
      allow read: if true;
      allow create: if isCommunityOwner(request.resource.data.authorId)
        && isValidPost(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.likeCount is int && request.resource.data.likeCount == 0
        && request.resource.data.viewCount is int && request.resource.data.viewCount == 0;
      allow update: if request.auth != null && (
        (isCommunityOwner(resource.data.authorId)
          && isValidPost(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'updatedAt'])
          && request.resource.data.updatedAt == request.time)
        || isLikeChange());
      // 댓글·이미지 정리를 포함한 게시글 삭제는 4단계에서 추가합니다.
      allow delete: if false;

      match /likes/{userId} {
        function hasCountChange(delta) {
          let path = /databases/$(database)/documents/communityPosts/$(postId);
          return getAfter(path).data.likeCount == get(path).data.likeCount + delta;
        }
        allow get: if isCommunityOwner(userId);
        allow create: if isCommunityOwner(userId)
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time && hasCountChange(1);
        allow delete: if isCommunityOwner(userId) && hasCountChange(-1);
      }
    }
    match /communityComments/{commentId} {
      function isValidComment(data) {
        return data.keys().hasAll(['postId', 'authorId', 'content', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['postId', 'authorId', 'content', 'createdAt', 'updatedAt'])
          && data.postId is string && data.postId.size() > 0
          && !data.postId.matches('.*[/].*')
          && isCommunityText(data.content, 1000)
          && exists(/databases/$(database)/documents/communityPosts/$(data.postId));
      }
      allow read: if true;
      allow create: if isCommunityOwner(request.resource.data.authorId)
        && isValidComment(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isCommunityOwner(resource.data.authorId)
        && isValidComment(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isCommunityOwner(resource.data.authorId);
    }
    match /profiles/{userId} {
      allow get: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nickname', 'imageUrl', 'bio', 'createdAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'imageUrl', 'bio', 'createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 100
        && request.resource.data.imageUrl == null
        && request.resource.data.bio == ''
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId}/favorites/{productId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function hasCountChange(delta) {
        let productPath = /databases/$(database)/documents/products/$(productId);
        let before = get(productPath).data.get('favoriteCount', 0);
        let after = getAfter(productPath).data.favoriteCount;
        return before is int && before >= 0
          && after is int && after >= 0 && after <= 9007199254740991
          && after == before + delta;
      }
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && hasCountChange(1);
      allow delete: if isOwner() && hasCountChange(-1);
    }

    match /products/{productId} {
      function isValidFavoriteChange() {
        let favoritePath = /databases/$(database)/documents/users/$(request.auth.uid)/favorites/$(productId);
        let before = resource.data.get('favoriteCount', 0);
        let after = request.resource.data.favoriteCount;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount'])
          && before is int && before >= 0
          && after is int && after >= 0 && after <= 9007199254740991
          && ((!exists(favoritePath) && existsAfter(favoritePath) && after == before + 1)
            || (exists(favoritePath) && !existsAfter(favoritePath) && after == before - 1));
      }
      function isValidProductText(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && data.description is string && data.description.size() > 0 && data.description.size() <= 5000;
      }
      function isValidTransaction(transaction) {
        return transaction is map && (
          (transaction.type == 'sale' && transaction.keys().hasOnly(['type', 'price'])
            && transaction.price is int && transaction.price >= 0)
          || (transaction.type == 'exchange' && transaction.keys().hasOnly(['type', 'desiredItemName'])
            && transaction.desiredItemName is string && transaction.desiredItemName.size() > 0
            && transaction.desiredItemName.size() <= 100)
        );
      }
      function isValidDelivery(delivery) {
        return delivery is map && (
          (delivery.type == 'direct' && delivery.keys().hasOnly(['type', 'location'])
            && delivery.location is string && delivery.location.size() > 0 && delivery.location.size() <= 200)
          || (delivery.type == 'parcel' && delivery.keys().hasOnly(['type', 'shippingFee'])
            && delivery.shippingFee is int && delivery.shippingFee >= 0)
        );
      }
      function isValidProductFields(data) {
        let fields = ['title', 'description', 'transaction', 'delivery', 'images', 'sellerId', 'status', 'createdAt'];
        return data.keys().hasAll(fields)
          && data.keys().hasOnly(fields.concat(['favoriteCount']))
          && data.get('favoriteCount', 0) is int
          && data.get('favoriteCount', 0) == 0;
      }
      function isValidImage(image) {
        return image is map && image.keys().hasAll(['url', 'path']) && image.keys().hasOnly(['url', 'path'])
          && image.url is string && image.url.size() <= 2048 && image.url.matches('https://.+')
          && image.path is string && image.path.size() > 0 && image.path.size() <= 1024;
      }
      function isValidImageAt(images, index) {
        return images.size() <= index || isValidImage(images[index]);
      }
      function isValidImages(images) {
        return images is list && images.size() >= 1 && images.size() <= 10
          && isValidImageAt(images, 0) && isValidImageAt(images, 1)
          && isValidImageAt(images, 2) && isValidImageAt(images, 3)
          && isValidImageAt(images, 4) && isValidImageAt(images, 5)
          && isValidImageAt(images, 6) && isValidImageAt(images, 7)
          && isValidImageAt(images, 8) && isValidImageAt(images, 9);
      }
      allow read: if true;
      allow update: if request.auth != null && isValidFavoriteChange();
      allow create: if request.auth != null
        && isValidProductFields(request.resource.data)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'available'
        && request.resource.data.createdAt == request.time
        && isValidProductText(request.resource.data)
        && isValidTransaction(request.resource.data.transaction)
        && isValidDelivery(request.resource.data.delivery)
        && isValidImages(request.resource.data.images);
    }
  }
}
