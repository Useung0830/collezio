rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveUser() {
      return request.auth != null && !exists(/databases/$(database)/documents/withdrawalRequests/$(request.auth.uid));
    }
    match /withdrawalRequests/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
    }
    function canChat(firstId, secondId) {
      return !exists(/databases/$(database)/documents/withdrawalRequests/$(firstId))
        && !exists(/databases/$(database)/documents/withdrawalRequests/$(secondId))
        && !existsAfter(/databases/$(database)/documents/users/$(firstId)/chatBlocks/$(secondId))
        && !existsAfter(/databases/$(database)/documents/users/$(secondId)/chatBlocks/$(firstId));
    }
    match /users/{userId}/chatBlocks/{partnerId} {
      // 상대방은 자신과의 차단 여부만 조회할 수 있고 전체 목록은 읽을 수 없습니다.
      allow get: if isActiveUser() && request.auth.uid in [userId, partnerId];
      allow list: if isActiveUser() && request.auth.uid == userId;
      allow create: if isActiveUser() && request.auth.uid == userId && userId != partnerId
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if isActiveUser() && request.auth.uid == userId;
    }
    match /users/{userId}/chatReports/{reportId} {
      function isValidReport() {
        let data = request.resource.data;
        let room = get(/databases/$(database)/documents/chatRooms/$(data.roomId)).data;
        return data.keys().hasAll(['partnerId', 'roomId', 'reason', 'details', 'createdAt'])
          && data.keys().hasOnly(['partnerId', 'roomId', 'reason', 'details', 'createdAt'])
          && data.roomId is string && data.partnerId is string
          && request.auth.uid in room.visibleTo && userId != data.partnerId
          && ((room.requesterId == userId && room.sellerId == data.partnerId)
            || (room.sellerId == userId && room.requesterId == data.partnerId))
          && data.reason in ['스팸·광고', '사기 의심', '욕설·괴롭힘', '부적절한 콘텐츠', '기타']
          && data.details is string && data.details.size() <= 1000
          && (data.reason != '기타' || data.details.matches('(?s).*\\S.*'))
          && data.createdAt == request.time;
      }
      allow get: if isActiveUser() && request.auth.uid == userId;
      allow create: if isActiveUser() && request.auth.uid == userId && isValidReport();
    }
    function isCommunityOwner(authorId) {
      return isActiveUser() && request.auth.uid == authorId;
    }
    function isCommunityText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum
        && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }
    function canCleanCommunityPost(postId) {
      return isActiveUser()
        && get(/databases/$(database)/documents/communityPostDeletions/$(postId)).data.authorId == request.auth.uid;
    }
    match /communityPostDeletions/{postId} {
      allow get: if isActiveUser() && (!exists(/databases/$(database)/documents/communityPostDeletions/$(postId)) || isCommunityOwner(resource.data.authorId));
      allow create: if isCommunityOwner(request.resource.data.authorId)
        && request.resource.data.keys().hasAll(['authorId', 'images', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'images', 'createdAt'])
        && request.resource.data.authorId == get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId
        && request.resource.data.images == get(/databases/$(database)/documents/communityPosts/$(postId)).data.images
        && request.resource.data.createdAt == request.time
        && !existsAfter(/databases/$(database)/documents/communityPosts/$(postId));
      allow delete: if isCommunityOwner(resource.data.authorId);
    }
    match /communityPosts/{postId} {
      function isValidCommunityImage(image, authorId) {
        return image.keys().hasOnly(['path', 'url'])
          && image.path.matches('community/' + authorId + '/' + postId + '/[a-zA-Z0-9-]{1,64}')
          && image.url.size() <= 2048
          && image.url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[a-zA-Z0-9.-]+/o/'
            + image.path.replace('/', '%2F') + '[?]alt=media(&token=[a-zA-Z0-9-]+)?');
      }
      function isValidCommunityImageAt(images, index, authorId) {
        return images.size() <= index || isValidCommunityImage(images[index], authorId);
      }
      function isValidCommunityImages(images, authorId) {
        return images is list && images.size() <= 10
          && authorId.matches('[a-zA-Z0-9_-]{1,128}') && postId.matches('[a-zA-Z0-9_-]{1,128}')
          && isValidCommunityImageAt(images, 0, authorId) && isValidCommunityImageAt(images, 1, authorId)
          && isValidCommunityImageAt(images, 2, authorId) && isValidCommunityImageAt(images, 3, authorId)
          && isValidCommunityImageAt(images, 4, authorId) && isValidCommunityImageAt(images, 5, authorId)
          && isValidCommunityImageAt(images, 6, authorId) && isValidCommunityImageAt(images, 7, authorId)
          && isValidCommunityImageAt(images, 8, authorId) && isValidCommunityImageAt(images, 9, authorId);
      }
      function isValidPost(data) {
        return data.keys().hasAll(['authorId', 'title', 'content', 'images', 'createdAt', 'updatedAt', 'likeCount', 'viewCount'])
          && data.keys().hasOnly(['authorId', 'title', 'content', 'images', 'createdAt', 'updatedAt', 'likeCount', 'viewCount'])
          && isCommunityText(data.title, 100) && isCommunityText(data.content, 5000)
          && isValidCommunityImages(data.images, data.authorId);
      }
      function isLikeChange() {
        let path = /databases/$(database)/documents/communityPosts/$(postId)/likes/$(request.auth.uid);
        let before = resource.data.likeCount;
        let after = request.resource.data.likeCount;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && after is int && after >= 0 && after <= 9007199254740991
          && ((!exists(path) && existsAfter(path) && after == before + 1)
            || (exists(path) && !existsAfter(path) && after == before - 1));
      }
      allow read: if true;
      allow create: if isCommunityOwner(request.resource.data.authorId)
        && !exists(/databases/$(database)/documents/communityPostDeletions/$(postId))
        && isValidPost(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.likeCount is int && request.resource.data.likeCount == 0
        && request.resource.data.viewCount is int && request.resource.data.viewCount == 0;
      allow update: if isActiveUser() && !exists(/databases/$(database)/documents/withdrawalRequests/$(resource.data.authorId)) && (
        (isCommunityOwner(resource.data.authorId)
          && isValidPost(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'images', 'updatedAt'])
          && request.resource.data.updatedAt == request.time)
        || isLikeChange());
      allow delete: if isCommunityOwner(resource.data.authorId)
        && getAfter(/databases/$(database)/documents/communityPostDeletions/$(postId)).data.authorId == resource.data.authorId
        && getAfter(/databases/$(database)/documents/communityPostDeletions/$(postId)).data.images == resource.data.images;

      match /likes/{userId} {
        function hasCountChange(delta) {
          let path = /databases/$(database)/documents/communityPosts/$(postId);
          return getAfter(path).data.likeCount == get(path).data.likeCount + delta;
        }
        allow get: if isCommunityOwner(userId);
        allow list: if canCleanCommunityPost(postId);
        allow create: if isCommunityOwner(userId)
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId != userId
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time && hasCountChange(1);
        allow delete: if (isCommunityOwner(userId) && hasCountChange(-1)) || canCleanCommunityPost(postId);
      }
    }
    match /communityComments/{commentId} {
      function isValidComment(data) {
        return data.keys().hasAll(['postId', 'authorId', 'content', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['postId', 'authorId', 'content', 'createdAt', 'updatedAt'])
          && data.postId is string && data.postId.size() > 0
          && !data.postId.matches('.*[/].*')
          && isCommunityText(data.content, 1000)
          && existsAfter(/databases/$(database)/documents/communityPosts/$(data.postId))
          && !exists(/databases/$(database)/documents/withdrawalRequests/$(get(/databases/$(database)/documents/communityPosts/$(data.postId)).data.authorId));
      }
      allow read: if true;
      allow create: if isCommunityOwner(request.resource.data.authorId)
        && isValidComment(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isCommunityOwner(resource.data.authorId)
        && request.time < resource.data.createdAt + duration.value(5, 'm')
        && isValidComment(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isCommunityOwner(resource.data.authorId) || canCleanCommunityPost(resource.data.postId);
    }
    match /users/{userId}/productChats/{productId} {
      function isOwner() {
        return isActiveUser() && request.auth.uid == userId;
      }
      function isValidLink() {
        let data = request.resource.data;
        let roomPath = /databases/$(database)/documents/chatRooms/$(data.roomId);
        let room = getAfter(roomPath).data;
        return data.keys().hasAll(['roomId']) && data.keys().hasOnly(['roomId'])
          && data.roomId is string && data.roomId.matches('^[A-Za-z0-9]{20}$')
          && !exists(roomPath)
          && room.requesterId == userId && room.productId == productId;
      }
      allow get: if isOwner();
      allow create: if isOwner() && isValidLink();
    }

    match /chatRooms/{roomId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['content', 'senderId', 'createdAt'])
          && data.keys().hasOnly(['content', 'senderId', 'createdAt'])
          && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && data.content.matches('(?s).*\\S.*')
          && data.senderId == request.auth.uid && data.createdAt == request.time;
      }
      function hasNewMessage() {
        let summary = request.resource.data.lastMessage;
        let messagePath = /databases/$(database)/documents/chatRooms/$(roomId)/messages/$(summary.id);
        let message = getAfter(messagePath).data;
        return summary.keys().hasAll(['id', 'content', 'senderId', 'createdAt'])
          && summary.keys().hasOnly(['id', 'content', 'senderId', 'createdAt'])
          && summary.id is string && summary.id.size() > 0 && summary.id.size() <= 128
          && !exists(messagePath) && isValidMessage(message)
          && summary.content == message.content && summary.senderId == message.senderId
          && summary.createdAt == message.createdAt;
      }
      function hasChatCountIncrement() {
        let productPath = /databases/$(database)/documents/products/$(resource.data.productId);
        let before = get(productPath).data.get('chatCount', 0);
        let after = getAfter(productPath).data.chatCount;
        return before is int && before >= 0 && after is int && after == before + 1
          && after <= 9007199254740991;
      }
      function isValidMessageUpdate() {
        return request.auth.uid in resource.data.visibleTo
          && canChat(resource.data.requesterId, resource.data.sellerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'visibleTo', 'lastMessage'])
          && request.resource.data.status == 'active'
          && request.resource.data.visibleTo == [resource.data.requesterId, resource.data.sellerId]
          && hasNewMessage()
          && ((resource.data.status == 'draft' && request.auth.uid == resource.data.requesterId && hasChatCountIncrement())
            || resource.data.status == 'active');
      }
      function isValidDraft() {
        let data = request.resource.data;
        let productPath = /databases/$(database)/documents/products/$(data.productId);
        let linkPath = /databases/$(database)/documents/users/$(request.auth.uid)/productChats/$(data.productId);
        return data.keys().hasAll(['productId', 'sellerId', 'requesterId', 'status', 'visibleTo', 'createdAt'])
          && data.keys().hasOnly(['productId', 'sellerId', 'requesterId', 'status', 'visibleTo', 'createdAt'])
          && roomId.matches('^[A-Za-z0-9]{20}$')
          && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 1500
          && data.productId.matches('^[^/]+$')
          && data.requesterId == request.auth.uid
          && data.sellerId is string && data.sellerId != request.auth.uid
          && data.sellerId == get(productPath).data.sellerId
          && canChat(data.requesterId, data.sellerId)
          && data.status == 'draft' && data.visibleTo == [request.auth.uid]
          && data.createdAt == request.time
          && !exists(linkPath) && getAfter(linkPath).data.roomId == roomId;
      }
      // 상대방은 첫 메시지 전송 전에는 목록뿐 아니라 직접 조회도 할 수 없습니다.
      allow read: if isActiveUser() && request.auth.uid in resource.data.visibleTo;
      allow create: if isActiveUser() && isValidDraft();
      allow update: if isActiveUser() && isValidMessageUpdate();

      match /messages/{messageId} {
        function canAccessRoom() {
          return isActiveUser()
            && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.visibleTo;
        }
        function matchesRoomSummary() {
          let room = getAfter(/databases/$(database)/documents/chatRooms/$(roomId)).data;
          let data = request.resource.data;
          return canChat(room.requesterId, room.sellerId)
            && room.status == 'active' && room.lastMessage.id == messageId
            && room.lastMessage.content == data.content && room.lastMessage.senderId == data.senderId
            && room.lastMessage.createdAt == data.createdAt;
        }
        allow read: if canAccessRoom();
        allow create: if canAccessRoom() && messageId.size() > 0 && messageId.size() <= 128
          && isValidMessage(request.resource.data) && matchesRoomSummary();
      }
    }

    match /profiles/{userId} {
      allow get: if true;
      allow create: if isActiveUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nickname', 'imageUrl', 'bio', 'createdAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'imageUrl', 'bio', 'createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 100
        && request.resource.data.imageUrl == null
        && request.resource.data.bio == ''
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId}/favorites/{productId} {
      function isOwner() {
        return isActiveUser() && request.auth.uid == userId;
      }
      function hasCountChange(delta) {
        let productPath = /databases/$(database)/documents/products/$(productId);
        let before = get(productPath).data.get('favoriteCount', 0);
        let after = getAfter(productPath).data.favoriteCount;
        return before is int && before >= 0
          && after is int && after >= 0 && after <= 9007199254740991
          && after == before + delta;
      }
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && hasCountChange(1);
      allow delete: if isOwner() && hasCountChange(-1);
    }

    match /products/{productId} {
      function isValidChatCountChange() {
        let linkPath = /databases/$(database)/documents/users/$(request.auth.uid)/productChats/$(productId);
        let roomPath = /databases/$(database)/documents/chatRooms/$(get(linkPath).data.roomId);
        let roomBefore = get(roomPath).data;
        let roomAfter = getAfter(roomPath).data;
        let before = resource.data.get('chatCount', 0);
        let after = request.resource.data.chatCount;
        return roomBefore.productId == productId && roomBefore.requesterId == request.auth.uid
          && roomBefore.sellerId == resource.data.sellerId
          && roomBefore.status == 'draft' && roomAfter.status == 'active'
          && before is int && before >= 0 && after is int && after == before + 1
          && after <= 9007199254740991;
      }
      function isValidFavoriteChange() {
        let favoritePath = /databases/$(database)/documents/users/$(request.auth.uid)/favorites/$(productId);
        let before = resource.data.get('favoriteCount', 0);
        let after = request.resource.data.favoriteCount;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount'])
          && before is int && before >= 0
          && after is int && after >= 0 && after <= 9007199254740991
          && ((!exists(favoritePath) && existsAfter(favoritePath) && after == before + 1)
            || (exists(favoritePath) && !existsAfter(favoritePath) && after == before - 1));
      }
      function isValidProductText(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && data.description is string && data.description.size() > 0 && data.description.size() <= 5000;
      }
      function isValidTransaction(transaction) {
        return transaction is map && (
          (transaction.type == 'sale' && transaction.keys().hasOnly(['type', 'price'])
            && transaction.price is int && transaction.price >= 0)
          || (transaction.type == 'exchange' && transaction.keys().hasOnly(['type', 'desiredItemName'])
            && transaction.desiredItemName is string && transaction.desiredItemName.size() > 0
            && transaction.desiredItemName.size() <= 100)
        );
      }
      function isValidDelivery(delivery) {
        return delivery is map && (
          (delivery.type == 'direct' && delivery.keys().hasOnly(['type', 'location'])
            && delivery.location is string && delivery.location.size() > 0 && delivery.location.size() <= 200)
          || (delivery.type == 'parcel' && delivery.keys().hasOnly(['type', 'shippingFee'])
            && delivery.shippingFee is int && delivery.shippingFee >= 0)
        );
      }
      function isValidProductFields(data) {
        let fields = ['title', 'description', 'transaction', 'delivery', 'images', 'sellerId', 'status', 'createdAt'];
        return data.keys().hasAll(fields)
          && data.keys().hasOnly(fields.concat(['favoriteCount']))
          && data.get('favoriteCount', 0) is int
          && data.get('favoriteCount', 0) == 0;
      }
      function isValidImage(image) {
        return image is map && image.keys().hasAll(['url', 'path']) && image.keys().hasOnly(['url', 'path'])
          && image.url is string && image.url.size() <= 2048 && image.url.matches('https://.+')
          && image.path is string && image.path.size() > 0 && image.path.size() <= 1024;
      }
      function isValidImageAt(images, index) {
        return images.size() <= index || isValidImage(images[index]);
      }
      function isValidImages(images) {
        return images is list && images.size() >= 1 && images.size() <= 10
          && isValidImageAt(images, 0) && isValidImageAt(images, 1)
          && isValidImageAt(images, 2) && isValidImageAt(images, 3)
          && isValidImageAt(images, 4) && isValidImageAt(images, 5)
          && isValidImageAt(images, 6) && isValidImageAt(images, 7)
          && isValidImageAt(images, 8) && isValidImageAt(images, 9);
      }
      allow read: if true;
      allow update: if isActiveUser()
        && !exists(/databases/$(database)/documents/withdrawalRequests/$(resource.data.sellerId))
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount']) && isValidFavoriteChange())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatCount']) && isValidChatCountChange()));
      allow create: if isActiveUser()
        && isValidProductFields(request.resource.data)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'available'
        && request.resource.data.createdAt == request.time
        && isValidProductText(request.resource.data)
        && isValidTransaction(request.resource.data.transaction)
        && isValidDelivery(request.resource.data.delivery)
        && isValidImages(request.resource.data.images);
    }
  }
}
